ENVIRONMENT=development
ENABLE_DOCS=true
# Local Postgres. Create the role and database as the README describes,
# then put the password you chose here.
DATABASE_URL=postgresql+psycopg://kyc:CHANGE_ME@localhost:5432/kyc
REDIS_URL=redis://localhost:6379/0

# Evidence (document photos, the portrait, the liveness clip) is kept in Google
# Drive, reached with a service account key, the way our database backups are.
# From the key's JSON, two fields:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private key, with its newlines written as \n, quoted:
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Or, if you would rather mount the whole key file, its contents instead:
GOOGLE_SERVICE_ACCOUNT_JSON=

# The folder evidence goes in, on a Shared Drive the service account is a member
# of, its id out of the URL:
# https://drive.google.com/drive/folders/THIS_PART
GOOGLE_DRIVE_FOLDER_ID=
# The platform's own folder inside it, made on first use:
GOOGLE_DRIVE_ROOT_FOLDER=KYC Verifications

# Where evidence goes while none of the above is set: a folder on this machine.
# That is how tests and a developer's laptop run.
EVIDENCE_DIR=var/evidence

# Separate AML service; use its private DNS/address, not container localhost.
YENTE_BASE_URL=https://aml.tuesday.africa
YENTE_API_TOKEN=
YENTE_SCREENING_DATASET=sanctions
YENTE_POSSIBLE_THRESHOLD=0.7
YENTE_STRONG_THRESHOLD=0.9
